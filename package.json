{
  "name": "multirp",
  "version": "1.9.71",
  "description": "MultiRP — Multi-profile Discord Rich Presence manager. Up to 5 profiles, each with its own Client ID. Toggle one active at a time.",
  "main": "src/main/main.js",
  "author": {
    "name": "Alarkius Elvya Jay",
    "email": "alarkiusj2020@gmail.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.alarkius.multirp",
    "productName": "MultiRP",
    "copyright": "Copyright © 2026 Alarkius Elvya Jay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiRP"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Alarkius Elvya Jay <alarkiusj2020@gmail.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AlarkiusJay",
        "repo": "MultiRPCustomizer",
        "releaseType": "release"
      }
    ]
  }
}
